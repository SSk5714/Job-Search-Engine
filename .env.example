# Copy to .env and fill in. Never commit .env.

# production (default in Docker) refuses to start with placeholder secrets; development only warns
# JOBPILOT_ENV=production

# Required: at least 32 random characters. Generate: python -c "import secrets;print(secrets.token_hex(32))"
JOBPILOT_SECRET_KEY=

# First-run login (created once if no user exists; at least 12 characters). Change it later in Settings & Health.
JOBPILOT_ADMIN_USERNAME=shubham
JOBPILOT_ADMIN_PASSWORD=

# Required for Docker: database password (generate one like the secret key)
POSTGRES_PASSWORD=

# Server deployment only (docker-compose.prod.yml): your domain, HTTPS is automatic
# JOBPILOT_DOMAIN=jobs.example.org
# JOBPILOT_PUBLIC_BASE_URL=https://jobs.example.org

# Set to true when serving over HTTPS (the prod compose file does this for you)
JOBPILOT_COOKIE_SECURE=false

# Local (non-Docker) development only
# JOBPILOT_DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/jobpilot
# JOBPILOT_REDIS_URL=redis://localhost:6379/0   # leave unset to run searches in-process

# Claude API (matching and documents). Server-side only; never exposed to the browser.
# JOBPILOT_ANTHROPIC_API_KEY=
# JOBPILOT_CLAUDE_MODEL=claude-haiku-5-5

# Where generated CVs and cover letters are stored (contains personal data; back it up, keep it private)
# JOBPILOT_DOCUMENTS_DIR=./storage/documents

# Application form preparation (Playwright). Keep private hosts blocked except for the local mock portal.
# JOBPILOT_BROWSER_HEADLESS=true
# JOBPILOT_BROWSER_ALLOW_PRIVATE_HOSTS=false
# JOBPILOT_FOLLOW_UP_DAYS=10

# Scheduling and monitoring (Phase 5)
# JOBPILOT_SCHEDULER_INTERVAL_S=60
# JOBPILOT_MONITOR_INTERVAL_S=60
# JOBPILOT_RUN_STALL_MINUTES=30          # a run still "running" after this is marked failed
# JOBPILOT_PUBLIC_BASE_URL=http://localhost:3000   # links in emails

# Email notifications (optional; in-app notifications always work). Keep real values in .env only.
# JOBPILOT_SMTP_HOST=smtp.example.org
# JOBPILOT_SMTP_PORT=587
# JOBPILOT_SMTP_USERNAME=
# JOBPILOT_SMTP_PASSWORD=
# JOBPILOT_SMTP_STARTTLS=true
# JOBPILOT_EMAIL_FROM=jobpilot@example.org
# JOBPILOT_NOTIFY_EMAIL_TO=you@example.org

# Backups (Phase 6): daily at this Berlin time; newest N scheduled backups kept. Empty disables them.
# JOBPILOT_BACKUP_AT=03:15
# JOBPILOT_BACKUP_KEEP=14
# JOBPILOT_BACKUP_DIR=./storage/backups

# Practice jobs from the Mock job board (invented companies). Off in production; only for trying things out.
# JOBPILOT_TEST_JOBS=false

# Security limits
# JOBPILOT_LOGIN_MAX_FAILURES=5
# JOBPILOT_LOGIN_WINDOW_MINUTES=15
# JOBPILOT_MAX_REQUEST_BYTES=2000000
# JOBPILOT_API_DOCS=false
