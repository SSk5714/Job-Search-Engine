# Copy to .env and fill in. Never commit .env.

# Required: long random string used to sign session cookies
JOBPILOT_SECRET_KEY=replace-with-64-random-characters

# First-run login (created once if no user exists). Change the password after first sign-in is supported in a later phase.
JOBPILOT_ADMIN_USERNAME=shubham
JOBPILOT_ADMIN_PASSWORD=choose-a-strong-password

# Set to true when serving over HTTPS
JOBPILOT_COOKIE_SECURE=false

# Database password used by docker-compose
POSTGRES_PASSWORD=jobpilot

# Local (non-Docker) development only
# JOBPILOT_DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/jobpilot
# JOBPILOT_REDIS_URL=redis://localhost:6379/0   # leave unset to run searches in-process

# Phase 2+: Claude API. Server-side only; never exposed to the browser.
# JOBPILOT_ANTHROPIC_API_KEY=
# JOBPILOT_CLAUDE_MODEL=   # choose a current model from Anthropic's docs when Phase 2 starts
